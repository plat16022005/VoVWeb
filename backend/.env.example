# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3002
NODE_ENV=development

# Firebase Project & Optional Admin Service Account JSON
FIREBASE_PROJECT_ID=valkyria-of-verya
# Optional: paste single-line Service Account JSON (or set GOOGLE_APPLICATION_CREDENTIALS path)
# If omitted, Backend verifies Firebase ID Tokens cryptographically and forwards user auth to Firestore REST API.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 Storage (Gacha Banner Images)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_DOMAIN=https://pub-your_bucket_id.r2.dev

