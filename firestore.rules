rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // Kiểm tra quyền Quản Trị Viên Tối Cao (Admin)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'Admin'] ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.Role in ['Admin', 'admin'])
      );
    }

    // Kiểm tra quyền Admin hoặc Manager
    function isAdminOrManager() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'manager', 'Admin', 'Manager'] ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.Role in ['Admin', 'Manager', 'admin', 'manager'])
      );
    }

    // Cấu hình game (GameInfo): Công khai đọc cho mọi người
    // Admin hoặc Manager đặc quyền điều chỉnh từ Web
    match /GameInfo/{document} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // Cấu hình hệ thống trò chơi (GameConfig: Terms, Policy, ServerList...):
    // Công khai đọc cho game client & web; chỉ Admin đặc quyền cập nhật
    match /GameConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cấu hình thông số tướng & Subcollection Profile hiển thị web:
    // Đọc công khai; Admin/Manager có quyền ghi
    match /HeroConfigs/{document=**} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // Dữ liệu danh sách Chiến Binh Valkyria (Characters):
    // - ĐỌC: Công khai cho khách truy cập website và game client không cần đăng nhập
    // - GHI: Chỉ Quản Trị Viên (Admin) hoặc Quản Lý (Manager) mới có quyền tạo, cập nhật, xóa
    match /Characters/{charId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // Cấu hình vật phẩm, trang bị, nguyên liệu (ItemConfigs): Công khai đọc cho game
    // Admin hoặc Manager đặc quyền điều chỉnh từ Web
    match /ItemConfigs/{document} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // Cấu hình Banner Gacha theo mùa (GachaBanners):
    // Công khai đọc cho Game Client (kể cả trước khi đăng nhập); chỉ Admin hoặc Manager được tạo/sửa từ Web
    match /GachaBanners/{seasonId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // Cấu hình máy chủ Gacha & công thức xác suất nội bộ (GachaServerConfigs):
    // Chỉ Firebase Admin SDK (Cloud Functions / Server) truy cập độc quyền, từ chối mọi truy cập từ Client
    match /GachaServerConfigs/{document=**} {
      allow read, write: if false;
    }

    // Kiểm tra dữ liệu hồ sơ người dùng (Users) hợp lệ (dùng chung cho create và update)
    function isValidUser(data) {
      return data.keys().size() <= 30
        && (!('UserId' in data) || (data.UserId is string && data.UserId.size() > 0 && data.UserId.size() <= 128))
        && (!('Username' in data) || data.Username == null || (data.Username is string && data.Username.size() <= 200))
        && (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 200))
        && (!('Email' in data) || data.Email == null || (data.Email is string && data.Email.size() <= 320))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 320))
        && (!('Role' in data) || data.Role == null || (data.Role is string && data.Role.size() <= 32))
        && (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 32))
        && (!('Status' in data) || (data.Status is string && data.Status.size() <= 32))
        && (!('status' in data) || (data.status is string && data.status.size() <= 32))
        && (!('IsBanned' in data) || data.IsBanned is bool)
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('Provider' in data) || data.Provider == null || (data.Provider is string && data.Provider.size() <= 32))
        && (!('provider' in data) || data.provider == null || (data.provider is string && data.provider.size() <= 32))
        && (!('CreatedAt' in data) || data.CreatedAt == null || data.CreatedAt is timestamp || data.CreatedAt is number || (data.CreatedAt is string && data.CreatedAt.size() <= 64))
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is number || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('LastLogin' in data) || data.LastLogin == null || data.LastLogin is timestamp || data.LastLogin is number || (data.LastLogin is string && data.LastLogin.size() <= 64))
        && (!('lastLogin' in data) || data.lastLogin == null || data.lastLogin is timestamp || data.lastLogin is number || (data.lastLogin is string && data.lastLogin.size() <= 64))
        && (!('BanDetails' in data) || data.BanDetails == null || (data.BanDetails is map && data.BanDetails.keys().size() <= 20))
        && (!('banDetails' in data) || data.banDetails == null || (data.banDetails is map && data.banDetails.keys().size() <= 20));
    }

    // Kiểm tra dữ liệu phân quyền chi tiết của Manager (Users/{userId}/Permissions/{permissionId})
    function isValidUserPermission(data, permissionId) {
      return permissionId.size() > 0 && permissionId.size() <= 100
        && data.keys().hasAll(['GroupId', 'GroupName', 'GroupCode', 'IsEnabled', 'SubPermissions'])
        && data.keys().hasOnly(['GroupId', 'GroupName', 'GroupCode', 'IsEnabled', 'SubPermissions', 'GrantedBy', 'UpdatedAt'])
        && data.GroupId is string && data.GroupId == permissionId
        && data.GroupName is string && data.GroupName.size() > 0 && data.GroupName.size() <= 200
        && data.GroupCode is string && data.GroupCode.size() > 0 && data.GroupCode.size() <= 100
        && data.IsEnabled is bool
        && data.SubPermissions is list && data.SubPermissions.size() <= 100
        && (!('GrantedBy' in data) || (data.GrantedBy is string && data.GrantedBy.size() <= 320))
        && (!('UpdatedAt' in data) || data.UpdatedAt is number || data.UpdatedAt is timestamp || (data.UpdatedAt is string && data.UpdatedAt.size() <= 64));
    }

    // Kiểm tra dữ liệu vật phẩm túi đồ người chơi (Users/{userId}/Inventory/{itemId})
    function isValidUserInventoryItem(data) {
      return data.keys().size() <= 30
        && (!('ItemId' in data) || (data.ItemId is string && data.ItemId.size() > 0 && data.ItemId.size() <= 128))
        && (!('ItemName' in data) || (data.ItemName is string && data.ItemName.size() <= 200))
        && (!('Rarity' in data) || (data.Rarity is string && data.Rarity.size() <= 64))
        && (!('Quantity' in data) || (data.Quantity is number && data.Quantity >= 0))
        && (!('UpdatedAt' in data) || data.UpdatedAt is timestamp || data.UpdatedAt is number || (data.UpdatedAt is string && data.UpdatedAt.size() <= 64));
    }

    // Kiểm tra dữ liệu trạng thái sự kiện của người chơi (Users/{userId}/EventStates/{eventId})
    function isValidUserEventState(data) {
      return data.keys().size() <= 30
        && (!('EventId' in data) || (data.EventId is string && data.EventId.size() > 0 && data.EventId.size() <= 128))
        && (!('EventTitle' in data) || (data.EventTitle is string && data.EventTitle.size() <= 200))
        && (!('SpinTickets' in data) || (data.SpinTickets is number && data.SpinTickets >= 0))
        && (!('TotalSpins' in data) || (data.TotalSpins is number && data.TotalSpins >= 0))
        && (!('LastUpdated' in data) || data.LastUpdated is timestamp || data.LastUpdated is number || (data.LastUpdated is string && data.LastUpdated.size() <= 64));
    }

    // Hồ sơ người dùng (Users):
    // - Cho phép ĐỌC CÔNG KHAI (allow read: if true) để kiểm tra trạng thái tài khoản (IsBanned, Role, Profile) mượt mà mà không bao giờ bị lỗi missing quyền
    // - GHI: Người dùng tự cập nhật hồ sơ của chính mình (request.auth.uid == userId); chỉ Admin mới có quyền tạo/cập nhật/xóa hồ sơ người khác và phân quyền
    // - CHỐNG LEO THANG ĐẶC QUYỀN: Người dùng thông thường chỉ được tự tạo với Role 'Player'/'player', không được tự phong Role hoặc tự gỡ IsBanned/Status 'banned'
    match /Users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && isValidUser(request.resource.data)
        && (
          (request.auth.uid == userId
           && request.resource.data.keys().hasOnly(['UserId', 'Username', 'Email', 'Role', 'Status', 'IsBanned', 'Provider', 'CreatedAt', 'LastLogin'])
           && (!('UserId' in request.resource.data) || request.resource.data.UserId == userId)
           && (!('Role' in request.resource.data) || request.resource.data.Role in ['Player', 'player'])
           && (!('IsBanned' in request.resource.data) || request.resource.data.IsBanned == false)
           && (!('Status' in request.resource.data) || request.resource.data.Status in ['active', 'pending'])
           && (!('Provider' in request.resource.data) || request.resource.data.Provider in ['Email', 'Google', 'Guest']))
          || isAdmin()
        );
      allow update: if request.auth != null
        && isValidUser(request.resource.data)
        && (
          (request.auth.uid == userId
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Username', 'Role', 'LastLogin', 'Status', 'IsBanned', 'Provider', 'PermissionGroups', 'Permissions'])
           && (!('Role' in request.resource.data) ||
               ('Role' in resource.data && request.resource.data.Role == resource.data.Role) ||
               (!('Role' in resource.data) && request.resource.data.Role in ['Player', 'player']))
           && (!('IsBanned' in request.resource.data) ||
               ('IsBanned' in resource.data && request.resource.data.IsBanned == resource.data.IsBanned) ||
               (!('IsBanned' in resource.data) && request.resource.data.IsBanned == false && (!('Status' in resource.data) || resource.data.Status != 'banned')))
           && (!('Status' in request.resource.data) ||
               ('Status' in resource.data && request.resource.data.Status == resource.data.Status) ||
               (!('Status' in resource.data) && (request.resource.data.Status == 'banned' || (request.resource.data.Status == 'active' && (!('IsBanned' in resource.data) || resource.data.IsBanned != true)))))
           && (!('Provider' in request.resource.data) ||
               ('Provider' in resource.data && request.resource.data.Provider == resource.data.Provider) ||
               request.resource.data.Provider in ['Email', 'Google', 'Guest'])
           && (!('PermissionGroups' in request.resource.data) ||
               ('PermissionGroups' in resource.data && request.resource.data.PermissionGroups == resource.data.PermissionGroups))
           && (!('Permissions' in request.resource.data) ||
               ('Permissions' in resource.data && request.resource.data.Permissions == resource.data.Permissions)))
          || isAdmin()
        );
      allow delete: if isAdmin();

      // Phân quyền chi tiết cho tài khoản Manager (Subcollection Permissions)
      match /Permissions/{permissionId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidUserPermission(request.resource.data, permissionId);
        allow delete: if isAdmin();
      }

      // Túi đồ người chơi (Subcollection Inventory)
      match /Inventory/{itemId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && (request.auth.uid == userId || isAdminOrManager())
          && isValidUserInventoryItem(request.resource.data);
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdminOrManager());
      }

      // Trạng thái sự kiện của người chơi (Subcollection EventStates)
      match /EventStates/{eventId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && (request.auth.uid == userId || isAdminOrManager())
          && isValidUserEventState(request.resource.data);
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdminOrManager());
      }
    }

    // Cấu hình hệ thống (SystemConfig): Công khai đọc cho mọi người (Điều khoản, Chính sách, Link tải...)
    // CHỈ CÓ ADMIN mới có quyền sửa đổi và xuất bản
    match /SystemConfig/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bộ đếm tài khoản & thông số hệ thống (Counters & DailyStats subcollections):
    // Cho phép đọc và ghi để các tương tác đăng ký / đăng nhập tự động cập nhật bộ đếm
    match /Counters/{document=**} {
      allow read, write: if true;
    }

    // Nhật ký hoạt động hệ thống (Logs):
    // Cho phép đọc và ghi đối với tài khoản quản trị và hệ thống
    match /Logs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Nhật ký kiểm toán quản trị CMS (AdminAuditLogs): Bảo vệ thông tin nhạy cảm (UpdatedBy, Email Admin...)
    // Chỉ Admin hoặc Manager mới có quyền đọc và ghi (Zero-Trust)
    match /AdminAuditLogs/{document=**} {
      allow read, write: if isAdminOrManager();
    }

    // Kiểm tra dữ liệu bài viết Blog hợp lệ (dùng chung cho create và update)
    function isValidBlog(data) {
      return data.keys().hasAll(['Title', 'Category', 'Content', 'Status', 'AuthorId'])
        && data.Title is string && data.Title.size() > 0 && data.Title.size() <= 200
        && data.Category is string && data.Category.size() <= 100
        && data.Content is string && data.Content.size() <= 900000
        && data.Status in ['Draft', 'Published']
        && data.AuthorId is string && data.AuthorId.size() <= 128
        && (!('Slug' in data) || (data.Slug is string && data.Slug.size() <= 250))
        && (!('Excerpt' in data) || (data.Excerpt is string && data.Excerpt.size() <= 1000))
        && (!('CoverUrl' in data) || (data.CoverUrl is string && data.CoverUrl.size() <= 2048))
        && (!('AuthorName' in data) || (data.AuthorName is string && data.AuthorName.size() <= 200))
        && (!('CreatedAt' in data) || data.CreatedAt is number)
        && (!('UpdatedAt' in data) || data.UpdatedAt is number)
        && (!('PublishedAt' in data) || data.PublishedAt == null || data.PublishedAt is number)
        && (!('FacebookPostId' in data) || data.FacebookPostId == null || (data.FacebookPostId is string && data.FacebookPostId.size() <= 200))
        && (!('FacebookPostUrl' in data) || data.FacebookPostUrl == null || (data.FacebookPostUrl is string && data.FacebookPostUrl.size() <= 2048))
        && (!('FacebookPublishedAt' in data) || data.FacebookPublishedAt == null || data.FacebookPublishedAt is number)
        && (!('FacebookAutoReplyEnabled' in data) || data.FacebookAutoReplyEnabled == null || data.FacebookAutoReplyEnabled is bool)
        && (!('FacebookAutoReplyMessage' in data) || data.FacebookAutoReplyMessage == null || (data.FacebookAutoReplyMessage is string && data.FacebookAutoReplyMessage.size() <= 2000))
        && (!('FacebookRepliedCommentIds' in data) || (data.FacebookRepliedCommentIds is list && data.FacebookRepliedCommentIds.size() <= 5000));
    }

    // Bài viết Blog (Blogs):
    // - ĐỌC: mọi người chỉ đọc được bài đã xuất bản (Published); Admin/Manager đọc được cả bản nháp
    // - GHI: chỉ Admin hoặc Manager; AuthorId không được thay đổi sau khi tạo
    match /Blogs/{postId} {
      allow read: if resource.data.Status == 'Published' || isAdminOrManager();
      allow create: if isAdminOrManager()
        && isValidBlog(request.resource.data)
        && request.resource.data.AuthorId == request.auth.uid;
      allow update: if isAdminOrManager()
        && isValidBlog(request.resource.data)
        && request.resource.data.AuthorId == resource.data.AuthorId;
      allow delete: if isAdminOrManager();

      // Bình luận Facebook đã được tự động trả lời: chỉ Admin hoặc Manager đọc/ghi
      match /FacebookRepliedComments/{commentId} {
        allow read, write: if isAdminOrManager();
      }
    }

    // Kiểm tra dữ liệu mã mời sự kiện WebEvents hợp lệ (dùng chung cho create và update)
    // Assumed Data Model (WebEvents/{eventId}/InviteCodes/{inviteCode}):
    // - Required: InviteCode (string == inviteCode, 4..24), OwnerUid (string 1..128),
    //             EventId (string == eventId, 1..128), CreatedAt (string 1..64)
    // - Optional: OwnerUsername (string <= 100)
    // - Immutable khi update: InviteCode, OwnerUid, EventId, CreatedAt
    function isValidEventInviteCode(data, eventId, inviteCode) {
      return eventId.size() > 0 && eventId.size() <= 128
        && inviteCode.size() >= 4 && inviteCode.size() <= 24
        && inviteCode.matches('^[A-Za-z0-9_-]{4,24}$')
        && data.keys().hasAll(['InviteCode', 'OwnerUid', 'EventId', 'CreatedAt'])
        && data.keys().hasOnly(['InviteCode', 'OwnerUid', 'OwnerUsername', 'EventId', 'CreatedAt'])
        && data.InviteCode is string && data.InviteCode == inviteCode
        && data.OwnerUid is string && data.OwnerUid.size() > 0 && data.OwnerUid.size() <= 128
        && data.EventId is string && data.EventId == eventId
        && data.CreatedAt is string && data.CreatedAt.size() > 0 && data.CreatedAt.size() <= 64
        && (!('OwnerUsername' in data) || (data.OwnerUsername is string && data.OwnerUsername.size() <= 100));
    }

    // Kiểm tra dữ liệu lượt hỗ trợ mã mời sự kiện WebEvents hợp lệ (dùng chung cho create và update)
    // Assumed Data Model (WebEvents/{eventId}/InviteCodes/{inviteCode}/Helps/{helperUid}):
    // - Required: HelperUid (string == helperUid, 1..128), OwnerUid (string != HelperUid, khớp InviteCode.OwnerUid),
    //             InviteCode (string == inviteCode, 4..24), CreatedAt (string 1..64)
    // - Optional: HelperUsername (string <= 100), TicketsEarned (int 1..10)
    // - Immutable khi update: HelperUid, OwnerUid, InviteCode, CreatedAt
    function isValidEventHelp(data, eventId, inviteCode, helperUid) {
      return eventId.size() > 0 && eventId.size() <= 128
        && inviteCode.size() >= 4 && inviteCode.size() <= 24
        && helperUid.size() > 0 && helperUid.size() <= 128
        && data.keys().hasAll(['HelperUid', 'OwnerUid', 'InviteCode', 'CreatedAt'])
        && data.keys().hasOnly(['HelperUid', 'HelperUsername', 'OwnerUid', 'InviteCode', 'TicketsEarned', 'CreatedAt'])
        && data.HelperUid is string && data.HelperUid == helperUid
        && data.OwnerUid is string && data.OwnerUid.size() > 0 && data.OwnerUid.size() <= 128
        && data.OwnerUid != helperUid
        && data.InviteCode is string && data.InviteCode == inviteCode
        && exists(/databases/$(database)/documents/WebEvents/$(eventId)/InviteCodes/$(inviteCode))
        && ('OwnerUid' in get(/databases/$(database)/documents/WebEvents/$(eventId)/InviteCodes/$(inviteCode)).data)
        && data.OwnerUid == get(/databases/$(database)/documents/WebEvents/$(eventId)/InviteCodes/$(inviteCode)).data.OwnerUid
        && data.CreatedAt is string && data.CreatedAt.size() > 0 && data.CreatedAt.size() <= 64
        && (!('HelperUsername' in data) || (data.HelperUsername is string && data.HelperUsername.size() <= 100))
        && (!('TicketsEarned' in data) || (data.TicketsEarned is int && data.TicketsEarned >= 1 && data.TicketsEarned <= 10));
    }

    // Sự kiện Web & Minigame Unity WebGL (WebEvents):
    // Công khai đọc cho Web & Game Client (tương tự GachaBanners); chỉ Admin hoặc Manager được tạo/sửa/xóa
    match /WebEvents/{eventId} {
      allow read: if true;
      allow write: if isAdminOrManager();

      // Trạng thái tham gia sự kiện của từng người chơi (PlayerStates)
      match /PlayerStates/{userId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdminOrManager());
      }

      // Lịch sử vòng quay / trúng thưởng sự kiện (SpinLogs)
      match /SpinLogs/{logId} {
        allow read: if true;
        allow create, update: if request.auth != null || isAdminOrManager();
        allow delete: if isAdminOrManager();
      }

      // Mã mời giới thiệu sự kiện (InviteCodes):
      // - ĐỌC: Người dùng đã đăng nhập (phục vụ tra cứu mã mời và danh sách hỗ trợ)
      // - TẠO: Chính chủ sở hữu (OwnerUid == request.auth.uid) khi sự kiện tồn tại, hoặc Admin/Manager
      // - CẬP NHẬT: Chỉ Admin/Manager (giữ nguyên schema và khóa cứng InviteCode, OwnerUid, EventId, CreatedAt)
      // - XÓA: Chỉ Admin/Manager
      match /InviteCodes/{inviteCode} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && isValidEventInviteCode(request.resource.data, eventId, inviteCode)
          && (
            (request.resource.data.OwnerUid == request.auth.uid &&
             exists(/databases/$(database)/documents/WebEvents/$(eventId))) ||
            isAdminOrManager()
          );
        allow update: if isAdminOrManager()
          && isValidEventInviteCode(request.resource.data, eventId, inviteCode)
          && request.resource.data.InviteCode == resource.data.InviteCode
          && request.resource.data.OwnerUid == resource.data.OwnerUid
          && request.resource.data.EventId == resource.data.EventId
          && request.resource.data.CreatedAt == resource.data.CreatedAt;
        allow delete: if isAdminOrManager();

        // Lượt nhập mã hỗ trợ (Helps):
        // - ĐỌC: Người dùng đã đăng nhập (phục vụ kiểm tra giới hạn và thứ tự ghi nhận)
        // - TẠO: Chính người hỗ trợ (helperUid == request.auth.uid) hoặc Admin/Manager;
        //        chống giả mạo HelperUid/OwnerUid, chống tự hỗ trợ và bắt buộc InviteCode cha tồn tại
        // - CẬP NHẬT: Chỉ Admin/Manager (giữ nguyên schema và khóa cứng HelperUid, OwnerUid, InviteCode, CreatedAt)
        // - XÓA: Chỉ Admin/Manager
        match /Helps/{helperUid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && (helperUid == request.auth.uid || isAdminOrManager())
            && isValidEventHelp(request.resource.data, eventId, inviteCode, helperUid);
          allow update: if isAdminOrManager()
            && isValidEventHelp(request.resource.data, eventId, inviteCode, helperUid)
            && request.resource.data.HelperUid == resource.data.HelperUid
            && request.resource.data.OwnerUid == resource.data.OwnerUid
            && request.resource.data.InviteCode == resource.data.InviteCode
            && request.resource.data.CreatedAt == resource.data.CreatedAt;
          allow delete: if isAdminOrManager();
        }
      }
    }

  }
}
