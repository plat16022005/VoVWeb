{
  "name": "vovweb",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Valkyria of Veyra - Web Application",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
